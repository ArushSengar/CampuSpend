# ==========================================
# CampuSpend Environment Configuration
# ==========================================

# 1. DATABASE
# Local development (default SQLite file):
DATABASE_URL="file:./campuspend.db"

# Cloud / Free Hosting (Turso SQLite - https://turso.tech):
# DATABASE_URL="libsql://campuspend-youruser.turso.io"
# DATABASE_AUTH_TOKEN="your-turso-auth-token"

# 2. SESSION SECURITY
# Any random 32+ character string used to sign session cookies
AUTH_SECRET="change-this-to-a-secure-random-secret-key-32-chars-min"

# 3. OPTIONAL AI ENHANCEMENTS (Fallback is offline deterministic engine)
# GEMINI_API_KEY="your-google-gemini-api-key"
# OPENAI_API_KEY="your-openai-api-key"
